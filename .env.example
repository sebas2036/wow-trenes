# ─── WoW TRENES — Variables de entorno ───────────────────────────────────────
# Copiá este archivo como .env y completá con tus propios valores.
# NUNCA subas .env a git — ya está en .gitignore.
# Tras editar, reiniciá Expo con: npx expo start --clear

# ── Travelpayouts (afiliado principal — Omio, Trip.com) ───────────────────────
# Registro gratuito: https://travelpayouts.com
EXPO_PUBLIC_TP_MARKER=
EXPO_PUBLIC_PARTNERIZE_TAG=

# ── SNCF Navitia (tablero tiempo real Francia) ────────────────────────────────
# Registro gratuito: https://api.sncf.com
EXPO_PUBLIC_SNCF_KEY=

# ── IDFM (metro París tiempo real) ───────────────────────────────────────────
# Registro gratuito: https://prim.iledefrance-mobilites.fr
EXPO_PUBLIC_IDFM_API_KEY=

# ── TMB Barcelona (metro tiempo real) ────────────────────────────────────────
# Registro gratuito: https://developer.tmb.cat
TMB_APP_ID=
TMB_APP_KEY=

# ── Google Maps ───────────────────────────────────────────────────────────────
# https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# ── Backend proxy (Railway: afiliados + ViaggiaTreno Italia) ──────────────────
# URL pública del backend (repo voxa, desplegado en Railway). No es secreto.
EXPO_PUBLIC_AFFILIATE_PROXY=https://voxa-production-dc15.up.railway.app/affiliate/redirect
