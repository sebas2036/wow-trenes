# ─── WoW TRENES — Variables de entorno ──────────────────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a git — ya está en .gitignore.

# ── APIs de trenes (live position + horarios) ────────────────────────────────
# SNCF (Francia) — https://data.sncf.com/api → registrarse gratis
EXPO_PUBLIC_SNCF_API_KEY=

# Deutsche Bahn (Alemania) — https://developer.deutschebahn.com → registrarse gratis
EXPO_PUBLIC_DB_API_KEY=

# NS (Países Bajos) — https://apiportal.ns.nl → registrarse gratis
EXPO_PUBLIC_NS_API_KEY=

# ── Afiliado Trainline / Rail Europe ─────────────────────────────────────────
# Partnerize — solicitar cuenta en partnerize.com/publishers
# El SID se asigna al aprobar la afiliación con Trainline
EXPO_PUBLIC_PARTNERIZE_SID=

# Impact Radius (alternativo) — https://impact.com
EXPO_PUBLIC_IMPACT_SID=

# ── Google Maps (ya configurado en app.json, solo para referencia) ───────────
# GOOGLE_MAPS_API_KEY=AIzaSyD-ni6YpWpx1c6igqsIiPn_ywbwG__3kqY

# ── EAS / Expo ───────────────────────────────────────────────────────────────
# Se configura automáticamente con: npx eas init
# EXPO_PROJECT_ID=
