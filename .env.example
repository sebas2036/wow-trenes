# ─── WoW TRENES — Variables de entorno ──────────────────────────────────────
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local a git — ya está en .gitignore.
# Tras editar, reinicia Expo con: npx expo start --clear

# ── Afiliado Trainline — MONETIZACIÓN ────────────────────────────────────────
# Cómo obtener las keys (~1-2 semanas):
#   Partnerize: https://partnerize.com/publishers → buscar "Trainline"
#   Impact:     https://app.impact.com → Partners → Trainline
EXPO_PUBLIC_AFFILIATE_ID=WOWTRENES_AFF_001
EXPO_PUBLIC_PARTNERIZE_TAG=p11p
EXPO_PUBLIC_IMPACT_SID=wow_trenes_sid

# ── SNCF Open Data (OPCIONAL — solo aumenta rate-limit) ──────────────────────
# La API data.sncf.com es OPEN DATA — funciona sin key (licencia ODbL).
# Sin key: ~10 req/s. Con key: rate-limit mayor.
# Registro gratuito (para key): https://data.sncf.com → Acceso/Registro
EXPO_PUBLIC_SNCF_API_KEY=

# ── Deutsche Bahn (requiere registro gratuito) ────────────────────────────────
# https://developer.deutschebahn.com → FahrPlan API (free tier)
EXPO_PUBLIC_DB_API_KEY=

# ── NS (Países Bajos — requiere registro gratuito) ───────────────────────────
# https://apiportal.ns.nl → Reisinformatie API
EXPO_PUBLIC_NS_API_KEY=

# ── LA Metro + Chicago CTA — posición GPS real (Swiftly) ─────────────────────
# Registro gratuito: https://forms.gle/hXGY6kRGAChDqWwz5
EXPO_PUBLIC_SWIFTLY_API_KEY=
