# WoW TRENES — Environment Variables
# Copy this file to .env.local and fill in the real keys.
# NEVER commit .env.local to git.

# ── Rail operator APIs (real-time only) ──────────────────────────────────
EXPO_PUBLIC_SNCF_API_KEY=your_sncf_key_here
EXPO_PUBLIC_DB_API_KEY=your_db_key_here
EXPO_PUBLIC_NS_API_KEY=your_ns_key_here

# ── Affiliate networks ────────────────────────────────────────────────────
# Partnerize (Impact) — configured in theme/index.ts
# EXPO_PUBLIC_PARTNERIZE_TAG=p11p (already embedded in theme)

# ── USA Real-time (Swiftly) ───────────────────────────────────────────────
# Registro gratuito: https://forms.gle/hXGY6kRGAChDqWwz5
# Cubre LA Metro Rail (lametro-rail), Chicago CTA (cta), y +300 agencias US
# VehiclePositions cada 5s · TripUpdates cada 10s
EXPO_PUBLIC_SWIFTLY_API_KEY=your_swiftly_key_here

# ── Maps ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
