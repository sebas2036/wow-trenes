{
  "expo": {
    "name": "WoW Train",
    "slug": "wow-trenes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wowtrenes",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#320079"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wowtrenes.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WoW Train usa tu ubicación para mostrarte estaciones cercanas y calcular el tiempo de llegada al tren.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "WoW Train usa tu ubicación en segundo plano para alertarte cuando te acercas a la estación y mostrarte tu QR automáticamente.",
        "NSLocationAlwaysUsageDescription": "WoW Train usa tu ubicación en segundo plano para el sistema de geocercas de estaciones.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "www.viaggiatreno.it": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#320079"
      },
      "package": "com.wowtrenes.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "INTERNET"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "WoW Train necesita tu ubicación para geocercas de estaciones.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7C3AED",
          "sounds": []
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-asset"
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "travelPayoutsMarker": "734304",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3d3e709c-a745-40b6-a3f1-a359587b7e1c"
      }
    },
    "owner": "sebasjasinsky"
  }
}